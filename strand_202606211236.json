{
"WITH tk AS (   -- every team's 4 resolved keys, as the ETL builds them\r\n  SELECT t.team_number,\r\n         r.support_request_year AS yr,\r\n         b.branch_id            AS br,\r\n         su.society_id          AS soc\r\n  FROM mrr_aa_new_teams t\r\n  LEFT JOIN mrr_aa_new_supportrequests r ON r.support_request_code = t.support_request_code\r\n  LEFT JOIN mrr_aa_new_branchs b          ON b.branch_code         = r.branch_code\r\n  LEFT JOIN mrr_aa_new_societyunions su   ON su.society_union_code = t.society_union_code\r\n),\r\nbud AS (   -- team-grain budgets that should attach\r\n  SELECT society_id, branch_id, team_number, support_request_year, approved_amount\r\n  FROM mrr_aa_budgets\r\n  WHERE request_type_filter = 'אגודה' AND approved_amount > 0 AND team_number > 0\r\n),\r\nstrand AS (   -- budgets with NO exact 4-key match\r\n  SELECT b.society_id, b.branch_id, b.team_number, b.support_request_year, b.approved_amount\r\n  FROM bud b\r\n  WHERE NOT EXISTS (\r\n    SELECT 1 FROM tk\r\n    WHERE tk.team_number = b.team_number\r\n      AND tk.yr  = b.support_request_year\r\n      AND tk.br  = b.branch_id\r\n      AND tk.soc = b.society_id)\r\n)\r\nSELECT\r\n  s.team_number,\r\n  s.approved_amount,\r\n  s.society_id          AS budget_society,\r\n  s.branch_id           AS budget_branch,\r\n  s.support_request_year AS budget_year,\r\n  -- what the registration actually says, on each key, when the other two match:\r\n  (SELECT MIN(tk.yr)  FROM tk\r\n     WHERE tk.team_number = s.team_number AND tk.br = s.branch_id\r\n       AND tk.soc = s.society_id)                                  AS reg_year_when_soc_branch_match,\r\n  (SELECT MIN(tk.soc) FROM tk\r\n     WHERE tk.team_number = s.team_number AND tk.yr = s.support_request_year\r\n       AND tk.br = s.branch_id)                                    AS reg_society_when_year_branch_match,\r\n  (SELECT MIN(tk.br)  FROM tk\r\n     WHERE tk.team_number = s.team_number AND tk.yr = s.support_request_year\r\n       AND tk.soc = s.society_id)                                  AS reg_branch_when_year_soc_match,\r\n  CASE\r\n    WHEN EXISTS (SELECT 1 FROM tk WHERE tk.team_number=s.team_number\r\n                   AND tk.br=s.branch_id AND tk.soc=s.society_id\r\n                   AND tk.yr IS DISTINCT FROM s.support_request_year) THEN 'year'\r\n    WHEN EXISTS (SELECT 1 FROM tk WHERE tk.team_number=s.team_number\r\n                   AND tk.yr=s.support_request_year AND tk.br=s.branch_id\r\n                   AND tk.soc IS DISTINCT FROM s.society_id)          THEN 'society'\r\n    WHEN EXISTS (SELECT 1 FROM tk WHERE tk.team_number=s.team_number\r\n                   AND tk.yr=s.support_request_year AND tk.soc=s.society_id\r\n                   AND tk.br IS DISTINCT FROM s.branch_id)            THEN 'branch'\r\n    ELSE 'no matching registration'\r\n  END AS failing_key\r\nFROM strand s\r\nORDER BY s.approved_amount DESC": [
